[Unit]
Description=Modellsteuerung: GPU-Umschaltung Whisper / Sprachmodell
After=network-online.target docker.service ollama.service
Wants=network-online.target

[Service]
User=modellsteuerung
WorkingDirectory=/opt/modellsteuerung
Environment=MESSWERTE=/opt/modellsteuerung/messwerte.log
Environment=WHISPER_UPSTREAM=http://127.0.0.1:8000
Environment=OLLAMA_UPSTREAM=http://10.77.0.3:11434
ExecStart=/opt/modellsteuerung/venv/bin/python /opt/modellsteuerung/app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
